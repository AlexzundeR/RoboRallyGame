[gd_scene format=3 uid="uid://top_panel_scene"]

[ext_resource type="Script" path="res://UI/TopPanel.cs" id="1"]

[node name="TopPanel" type="PanelContainer"]
script = ExtResource("1")

[node name="HBox" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 30

[node name="LeftPanel" type="VBoxContainer" parent="HBox"]
layout_mode = 2
theme_override_constants/separation = 2

[node name="Title" type="Label" parent="HBox/LeftPanel"]
layout_mode = 2
text = "ROBO RALLY"
horizontal_alignment = 1

[node name="RoundLabel" type="Label" parent="HBox/LeftPanel"]
layout_mode = 2
text = "Round: 1"

[node name="PhaseLabel" type="Label" parent="HBox/LeftPanel"]
layout_mode = 2
text = "PROGRAMMING"

[node name="MiddlePanel" type="VBoxContainer" parent="HBox"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="PriorityLabel" type="Label" parent="HBox/MiddlePanel"]
layout_mode = 2
text = "Priority: -"

[node name="RegisterLabel" type="Label" parent="HBox/MiddlePanel"]
layout_mode = 2
text = "Select register 1/5"

[node name="ActionPrompt" type="Label" parent="HBox/MiddlePanel"]
layout_mode = 2
text = "SELECT CARD FOR REGISTER 1"
horizontal_alignment = 1

[node name="RightPanel" type="VBoxContainer" parent="HBox"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="HelpLabel" type="Label" parent="HBox/RightPanel"]
layout_mode = 2
text = "Press 1-9 to select"

[node name="InfoButton" type="Button" parent="HBox"]
layout_mode = 2
text = "Info"
